---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useContent, routes, type Lang, type RouteKey } from '../i18n';
import { safeJsonLd } from '../utils/safeJsonLd';

interface Props {
  lang: Lang;
  routeKey: RouteKey | null;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { lang, routeKey, title, description, image = '/img/anasayfa-genel.webp', noindex = false } = Astro.props;
const t = useContent(lang);

const site = Astro.site ?? new URL('https://www.silverring.com.tr');
// Kısa marka adı kullanılır: tam unvan ("... Metal Sanayi A.Ş.") eklenirse SERP'te başlık kırpılıyordu.
const pageTitle = `${title} | ${t.company.name}`;
const canonical = routeKey ? new URL(routes[routeKey][lang], site).href : undefined;
const ogImage = new URL(image, site).href;

const alternates: { hreflang: string; href: string }[] = routeKey
  ? [
      { hreflang: 'tr', href: new URL(routes[routeKey].tr, site).href },
      { hreflang: 'en', href: new URL(routes[routeKey].en, site).href },
      { hreflang: 'x-default', href: new URL(routes[routeKey].tr, site).href },
    ]
  : [];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.company.legalName,
  alternateName: 'SilverRing',
  url: site.href,
  logo: new URL('/img/logo.png', site).href,
  email: t.company.email,
  telephone: `+90 262 646 70 77`,
  sameAs: ['https://www.linkedin.com/in/silver-ring-36817a28a'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gebze Güzeller O.S.B, İnönü Mah. Aşık Veysel Sok. No:2/1',
    addressLocality: 'Gebze',
    addressRegion: 'Kocaeli',
    addressCountry: 'TR',
  },
};

const breadcrumbLd =
  !routeKey || routeKey === 'home'
    ? null
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.nav.home, item: new URL(routes.home[lang], site).href },
          { '@type': 'ListItem', position: 2, name: title, item: canonical },
        ],
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.company.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION && (
      <meta name="yandex-verification" content={import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION} />
    )}

    <meta name="theme-color" content="#17110f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script is:inline type="application/ld+json" set:html={safeJsonLd(orgLd)} />
    {breadcrumbLd && <script is:inline type="application/ld+json" set:html={safeJsonLd(breadcrumbLd)} />}
    <script is:inline>
      // İçerik gizlenmesi JS'e bağlı kalmasın diye 'js' sınıfını senkron ekliyoruz.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <Header lang={lang} routeKey={routeKey ?? 'home'} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // ---- Mobil menü ----
      const body = document.body;
      const toggle = document.getElementById('navToggle');
      const scrim = document.getElementById('navScrim');
      const nav = document.getElementById('mainNav');

      const setMenu = (open: boolean) => {
        body.classList.toggle('nav-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
      };
      toggle?.addEventListener('click', () => setMenu(!body.classList.contains('nav-open')));
      scrim?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && body.classList.contains('nav-open')) setMenu(false);
      });

      // ---- Mobil alt menü akordeonu ----
      nav?.querySelectorAll(':scope > ul > li.has-sub > a').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (window.matchMedia('(max-width: 1180px)').matches) {
            e.preventDefault();
            link.parentElement?.classList.toggle('open');
          }
        });
      });

      // ---- Sticky header gölgesi ----
      const header = document.getElementById('siteHeader');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 6);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // ---- Kenar çubuğu scrollspy ----
      const docLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-nav a'));
      const docBlocks = Array.from(document.querySelectorAll<HTMLElement>('.doc-block'));
      if (docLinks.length && docBlocks.length) {
        const spy = () => {
          const pos = window.scrollY + 150;
          let current = docBlocks[0].id;
          for (const b of docBlocks) if (b.offsetTop <= pos) current = b.id;
          docLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${current}`));
        };
        spy();
        window.addEventListener('scroll', spy, { passive: true });
      }

      // ---- SSS akordeonu ----
      document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((acc) => {
        acc.querySelectorAll<HTMLButtonElement>('.acc-head').forEach((btn) => {
          btn.addEventListener('click', () => {
            const item = btn.closest('.acc-item') as HTMLElement | null;
            if (!item) return;
            const isOpen = item.classList.contains('open');
            acc.querySelectorAll('.acc-item.open').forEach((el) => {
              el.classList.remove('open');
              el.querySelector('.acc-head')?.setAttribute('aria-expanded', 'false');
              const b = el.querySelector('.acc-body') as HTMLElement | null;
              if (b) b.style.maxHeight = '';
            });
            if (!isOpen) {
              item.classList.add('open');
              btn.setAttribute('aria-expanded', 'true');
              const body = item.querySelector('.acc-body') as HTMLElement | null;
              if (body) body.style.maxHeight = body.scrollHeight + 'px';
            }
          });
        });
        // ilk açık öğeyi ölç
        const first = acc.querySelector('.acc-item.open .acc-body') as HTMLElement | null;
        if (first) first.style.maxHeight = first.scrollHeight + 'px';
      });

      // ---- Sayaç animasyonu ----
      const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
      if (counters.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const run = (el: HTMLElement) => {
          const raw = el.dataset.count || '';
          const num = parseInt(raw.replace(/\D/g, ''), 10);
          const suffix = raw.replace(/[0-9]/g, '');
          if (!num) return;
          const dur = 1100;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(num * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                run(e.target as HTMLElement);
                cio.unobserve(e.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        counters.forEach((c) => cio.observe(c));
      }

      // ---- Görünüme girince yumuşak geçiş ----
      const reveal = Array.from(document.querySelectorAll('[data-reveal]'));
      const revealAll = () => reveal.forEach((el) => el.classList.add('is-visible'));
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reveal.length || prefersReduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        reveal.forEach((el) => io.observe(el));
        // Güvenlik ağı: gözlemci güvenilmez ise içerik en geç ~1.2 sn'de görünür olur.
        const guard = () => setTimeout(revealAll, 1200);
        if (document.readyState === 'complete') guard();
        else window.addEventListener('load', guard);
      }
    </script>
  </body>
</html>
