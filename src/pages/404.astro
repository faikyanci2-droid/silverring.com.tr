---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  lang="tr"
  routeKey={null}
  title="Sayfa bulunamadı"
  description="Aradığınız sayfa taşınmış veya kaldırılmış olabilir."
  noindex
>
  <section class="section-ink" style="min-height:60vh;display:flex;align-items:center;">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h-title" style="color:#fff;">Sayfa bulunamadı / Page not found</h1>
      <p style="max-width:52ch;">
        Aradığınız sayfa taşınmış veya kaldırılmış olabilir. · The page you are looking for may have moved or been removed.
      </p>
      <div class="cta-row" style="margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/" class="btn btn-solid">Anasayfa <Icon name="arrow" class="arw" /></a>
        <a href="/en/" class="btn btn-ghost-light">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
