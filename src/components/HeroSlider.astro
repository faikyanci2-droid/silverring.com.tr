---
/**
 * Anasayfa hero arka planı: video + görsel karışık slider.
 * silverring.com.tr'deki anasayfa carousel'inin (ok + nokta navigasyonu, otomatik geçiş)
 * yeniden yapımı — canlı sitedeki gibi çember/varil üretim görüntüleri.
 */
export interface Slide {
  type: 'video' | 'image';
  src: string;
  alt?: string;
}
interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;
---

<div class="hero-slider" data-hero-slider>
  {
    slides.map((s, i) =>
      s.type === 'video' ? (
        // i === 0 dışındakilerde `src` bilerek atlanır: `preload="none"` tarayıcı ipucudur,
        // garanti değildir — bazı tarayıcılar sırası gelmemiş videoyu yine de tamamen indirebiliyor.
        // Gerçek indirme, `go()` içinde sıra geldiğinde `data-src`'den atanarak başlatılır.
        <video
          class="slide"
          data-index={i}
          src={i === 0 ? s.src : undefined}
          data-src={i === 0 ? undefined : s.src}
          muted
          playsinline
          preload={i === 0 ? 'metadata' : 'none'}
          poster={i === 0 ? '/img/hero-factory.webp' : undefined}
        />
      ) : (
        <img class="slide" data-index={i} src={s.src} alt={s.alt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />
      )
    )
  }
  {
    slides.length > 1 && (
      <>
        <button class="slider-arrow prev" type="button" aria-label="Önceki">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M15 5 L8 12 L15 19" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="slider-arrow next" type="button" aria-label="Sonraki">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M9 5 L16 12 L9 19" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="slider-dots">
          {slides.map((_, i) => (
            <button class={`dot${i === 0 ? ' active' : ''}`} type="button" data-goto={i} aria-label={`Slayt ${i + 1}`} />
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  function initHeroSlider(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.slider-arrow.prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.slider-arrow.next');
    if (slides.length === 0) return;

    let current = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;
    const SLIDE_DURATION = 5500;

    function clearTimer() {
      if (timer) clearTimeout(timer);
      timer = null;
    }

    function schedule() {
      clearTimer();
      timer = setTimeout(() => go(current + 1), SLIDE_DURATION);
    }

    function go(index: number) {
      const next = (index + slides.length) % slides.length;
      const prevEl = slides[current];
      const nextEl = slides[next];

      prevEl.classList.remove('active');
      if (prevEl.tagName === 'VIDEO') (prevEl as HTMLVideoElement).pause();

      dots[current]?.classList.remove('active');
      current = next;
      dots[current]?.classList.add('active');

      nextEl.classList.add('active');
      if (nextEl.tagName === 'VIDEO') {
        const v = nextEl as HTMLVideoElement;
        if (!v.getAttribute('src') && v.dataset.src) {
          v.src = v.dataset.src;
        }
        if (v.readyState > 0) v.currentTime = 0;
        v.play().catch(() => {});
      }
      schedule();
    }

    slides[0].classList.add('active');
    if (slides[0].tagName === 'VIDEO') {
      (slides[0] as HTMLVideoElement).play().catch(() => {});
    }
    schedule();

    prevBtn?.addEventListener('click', () => go(current - 1));
    nextBtn?.addEventListener('click', () => go(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
  }

  document.querySelectorAll<HTMLElement>('[data-hero-slider]').forEach(initHeroSlider);
</script>

<style>
  .hero-slider { position: absolute; inset: 0; overflow: hidden; opacity: 0.9; }
  .hero-slider .slide {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0; transition: opacity 1.1s ease;
  }
  .hero-slider .slide.active { opacity: 1; }

  .slider-arrow {
    position: absolute; bottom: 14px; z-index: 3;
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .45);
    background: rgba(11, 15, 21, .55); color: #fff; display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background .2s, border-color .2s;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .35);
  }
  .slider-arrow:hover { background: rgba(11, 15, 21, .8); border-color: rgba(255, 255, 255, .8); }
  .slider-arrow.prev { left: 20px; }
  .slider-arrow.next { right: 20px; }

  .slider-dots {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 3;
    display: flex; gap: 9px;
  }
  .slider-dots .dot {
    width: 9px; height: 9px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .6);
    background: transparent; padding: 0; cursor: pointer; transition: background .2s, transform .2s;
  }
  .slider-dots .dot.active { background: var(--white); border-color: var(--white); transform: scale(1.15); }

  @media (max-width: 640px) {
    .slider-arrow { display: none; }
  }
</style>
